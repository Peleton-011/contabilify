# Copiá este archivo a .env y completá con los datos de tu proyecto Supabase
# (Project Settings > API en el panel de Supabase).

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU-ANON-KEY

# Solo necesarias para el endpoint /api/keepalive (ver README > "Mantener
# activo el proyecto de Supabase"). No hace falta configurarlas para
# desarrollar localmente.
SUPABASE_SERVICE_KEY=TU-SERVICE-ROLE-KEY
CRON_SECRET=UNA-CADENA-ALEATORIA-LARGA
