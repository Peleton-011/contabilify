# Copia este archivo a .env y completa con los datos de tu proyecto Supabase
# (Project Settings > API en el panel de Supabase).

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU-ANON-KEY

# Necesaria para /api/keepalive Y para el panel de administración de usuarios
# (/usuarios), que invita usuarios nuevos con la Admin API de Supabase.
SUPABASE_SERVICE_KEY=TU-SERVICE-ROLE-KEY

# Solo para /api/keepalive (ver README > "Mantener activo el proyecto de
# Supabase"). No hace falta configurarla para desarrollar localmente.
CRON_SECRET=UNA-CADENA-ALEATORIA-LARGA

# URL pública de la app, usada como último recurso al construir el enlace de
# las invitaciones de usuario (normalmente se detecta sola desde la petición).
# En Vercel, configurala con la URL real de tu despliegue.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
